# Text files written for this repository are stored with LF line endings.
* text=auto eol=lf

# The source tree of the released executable and the build scripts are stored
# byte for byte, exactly as in the tree the release was built from and as in the
# release's source zip (some of these files use CRLF line endings).
src/** -text
build_tools/*.py -text

# Binary files.
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.zip binary
